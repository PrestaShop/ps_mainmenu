{% extends '@PrestaShop/Admin/layout.html.twig' %}
{% form_theme linkForm '@PrestaShop/Admin/TwigTemplateForm/prestashop_ui_kit.html.twig' %}

{% block content %}
  {{ form_start(linkForm) }}
  <div class="row justify-content-center">
    <div class="col-xl-10">
      <div class="card">
        <h3 class="card-header">
          <i class="material-icons">link</i>
          {{ title }}
        </h3>
        <div class="card-body">
          <div class="form-wrapper">
            {{ form_widget(linkForm) }}
          </div>
        </div>
        <div class="card-footer">
          <div class="d-flex justify-content-between">
            <a href="{{ path('ps_mainmenu_configuration') }}" class="btn btn-outline-secondary">{{ 'Cancel'|trans({}, 'Admin.Actions') }}</a>
            <button type="submit" class="btn btn-primary">{{ 'Save'|trans({}, 'Admin.Actions') }}</button>
          </div>
        </div>
      </div>
    </div>
  </div>
  {{ form_end(linkForm) }}
{% endblock %}

{% block javascripts %}
  {{ parent() }}

  <script src="{{ asset('../modules/ps_mainmenu/views/js/admin/link_form.js') }}"></script>
{% endblock %}
