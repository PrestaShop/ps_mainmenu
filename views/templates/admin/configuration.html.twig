{% extends '@PrestaShop/Admin/layout.html.twig' %}
{% trans_default_domain 'Modules.Mainmenu.Admin' %}

{% block content %}
  {% if not isSingleShopContext %}
    <div class="alert alert-warning" role="alert">
      <p class="alert-text">
        {{ 'You cannot manage top menu items from a "All Shops" or a "Group Shop" context, select directly the shop you want to edit'|trans }}
      </p>
    </div>
  {% elseif isMultiShopUsed %}
    <div class="alert alert-info" role="alert">
      <p class="alert-text">{{ 'The modifications will be applied to shop: %s'|trans|format(shopName) }}</p>
    </div>
  {% endif %}

  {% if isSingleShopContext %}
    {{ form_start(itemsForm, {'action': path('ps_mainmenu_configuration_save'), 'attr': {'id': 'ps-mainmenu-items-form'}}) }}
    <div class="card">
      <h3 class="card-header">
        <i class="material-icons">menu</i>
        {{ 'Menu Top Link'|trans }}
      </h3>
      <div class="card-body">
        <div class="row js-menu-items" data-field-name="{{ itemsForm.items.vars.full_name }}">
          <div class="col-lg-5">
            <label class="form-control-label" for="ps-mainmenu-selected">{{ 'Selected items'|trans }}</label>
            <select multiple id="ps-mainmenu-selected" class="form-control js-menu-items-selected" size="14">
              {% for value, label in selectedItems %}
                <option value="{{ value }}">{{ label }}</option>
              {% endfor %}
            </select>
            <div class="mt-2">
              <button type="button" class="btn btn-outline-secondary js-menu-items-up" title="{{ 'Change position'|trans }}">
                <i class="material-icons">keyboard_arrow_up</i>
              </button>
              <button type="button" class="btn btn-outline-secondary js-menu-items-down" title="{{ 'Change position'|trans }}">
                <i class="material-icons">keyboard_arrow_down</i>
              </button>
              <button type="button" class="btn btn-outline-secondary js-menu-items-remove">
                {{ 'Remove'|trans }}
                <i class="material-icons">arrow_forward</i>
              </button>
            </div>
          </div>

          <div class="col-lg-5">
            <label class="form-control-label" for="ps-mainmenu-available">{{ 'Available items'|trans }}</label>
            <select multiple id="ps-mainmenu-available" class="form-control js-menu-items-available" size="14">
              {% for group, choices in availableItems %}
                <optgroup label="{{ group }}">
                  {% for value, label in choices %}
                    <option value="{{ value }}">{{ label }}</option>
                  {% endfor %}
                </optgroup>
              {% endfor %}
            </select>
            <div class="mt-2">
              <button type="button" class="btn btn-outline-secondary js-menu-items-add">
                <i class="material-icons">arrow_back</i>
                {{ 'Add'|trans({}, 'Admin.Actions') }}
              </button>
            </div>
          </div>

          <div class="col-lg-2">
            <label class="form-control-label" for="ps-mainmenu-product">{{ 'Indicate the ID number for the product'|trans }}</label>
            <input type="number" min="1" step="1" id="ps-mainmenu-product" class="form-control js-menu-items-product"
                   data-label="{{ 'Product ID #'|trans }}">
            <div class="mt-2">
              <button type="button" class="btn btn-outline-secondary js-menu-items-add-product">
                <i class="material-icons">arrow_back</i>
                {{ 'Add'|trans({}, 'Admin.Actions') }}
              </button>
            </div>
          </div>
        </div>

        <div class="js-menu-items-values d-none">
          {% for item in itemsForm.items %}
            {{ form_widget(item) }}
          {% endfor %}
        </div>
        {% do itemsForm.items.setRendered %}
        {{ form_rest(itemsForm) }}
      </div>
      <div class="card-footer">
        <div class="d-flex justify-content-end">
          <button type="submit" class="btn btn-primary">{{ 'Save'|trans({}, 'Admin.Actions') }}</button>
        </div>
      </div>
    </div>
    {{ form_end(itemsForm) }}
  {% endif %}

  {{ include('@PrestaShop/Admin/Common/Grid/grid_panel.html.twig', {'grid': linkGrid}) }}
{% endblock %}

{% block javascripts %}
  {{ parent() }}

  <script src="{{ asset('../modules/ps_mainmenu/views/js/admin/configuration.js') }}"></script>
{% endblock %}
